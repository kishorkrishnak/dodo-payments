# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dodo_payments

# Invoice Service Port
PORT=8080

# Upstream Mock Payment Service Provider
PSP_BASE_URL=http://localhost:8081

# PSP Client Timeout in Seconds (tok_timeout sleeps 30s)
PSP_TIMEOUT_SECS=5

# Logging level
RUST_LOG=info
